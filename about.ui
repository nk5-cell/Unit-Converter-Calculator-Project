<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5">
  <object class="ttk.Frame" id="top_frame">
    <property name="height">200</property>
    <property name="padding">20</property>
    <property name="width">200</property>
    <layout manager="grid">
      <property name="column">0</property>
      <property name="row">0</property>
    </layout>
    <child>
      <object class="ttk.Label" id="title_label">
        <property name="font">{Arial} 18 {bold}</property>
        <property name="text" translatable="yes">Calculator Project</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">10</property>
          <property name="row">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="description_label">
        <property name="text" translatable="yes">This calculator converts grams to ounces and ounces to grams.</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="author_label">
        <property name="font">{Arial} 10 {italic}</property>
        <property name="text" translatable="yes">Created by: Nidhi Kairon</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">20</property>
          <property name="row">2</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
